package zip4cj.crypto

public class StandardEncrypter <: Encrypter {
    private let zipCryptoEngine = ZipCryptoEngine()
    private var headerBytes: Array<Byte>

    @OverflowWrapping
    public StandardEncrypter(password: ?Array<Rune>, key: Int64, useUtf8ForPassword: Bool) {
        if (password.isNone()) {
            throw ZipException("input password is null or empty, cannot initialize standard encrypter")
        }

        // Initialize encryption keys
        zipCryptoEngine.initKeys(password.getOrThrow(), useUtf8ForPassword)

        // Generate and encrypt 12 random bytes (this updates the key state)
        headerBytes = Array<Byte>(InternalZipConstants.STD_DEC_HDR_SIZE, repeat: 0)
        var random = SecureRandom()
        for (i in 0..headerBytes.size) {
            let randomByte = random.nextUInt8()
            headerBytes[i] = encryptByte(randomByte)
        }

        // Initialize keys again since the generated bytes were encrypted
        zipCryptoEngine.initKeys(password.getOrThrow(), useUtf8ForPassword)

        // Write verification bytes (overwriting the last 2 bytes)
        let verifByte1 = UInt8((key >> 16) & 0xFF)
        let verifByte2 = UInt8(key >> 24)
        headerBytes[InternalZipConstants.STD_DEC_HDR_SIZE - 2] = verifByte1
        headerBytes[InternalZipConstants.STD_DEC_HDR_SIZE - 1] = verifByte2

        // Encrypt the entire header (including verification bytes)
        encryptData(headerBytes)
    }

    private func formatBytes(bytes: Array<Byte>): String {
        var result = "["
        for (i in 0..bytes.size) {
            result += UInt32(UInt8(bytes[i])).toString()
            if (i < bytes.size - 1) {
                result += ","
            }
        }
        result += "]"
        return result
    }

    public func encryptData(buff: Array<UInt8>): Int64 {
        return encryptData(buff, 0, buff.size)
    }

    func encryptData(buff: Array<UInt8>, start: Int64, len: Int64): Int64 {
        if (len < 0) {
            throw ZipException("invalid length specified to decrpyt data")
        }

        // Print first few bytes before encryption
        if (len > 0) {
            var previewSize: Int64 = 16
            if (len < 16) {
                previewSize = len
            }
            var preview = "Before: ["
            for (i in start..start + previewSize) {
                preview += UInt32(buff[i]).toString()
                if (i < start + previewSize - 1) {
                    preview += ","
                }
            }
            preview += "]"
        }
        
        for (i in start..start + len) {
            let val = buff[i]
            let decryptedByte = zipCryptoEngine.decryptByte()
            let temp_val = UInt8((val ^ decryptedByte) & 0xff)
            zipCryptoEngine.updateKeys(val)
            buff[i] = temp_val
        }
        
        // Print first few bytes after encryption
        if (len > 0) {
            var previewSize: Int64 = 16
            if (len < 16) {
                previewSize = len
            }
            var preview = "After: ["
            for (i in start..start + previewSize) {
                preview += UInt32(buff[i]).toString()
                if (i < start + previewSize - 1) {
                    preview += ","
                }
            }
            preview += "]"
        }
        
        return len
    }

    protected func encryptByte(val: Byte): Byte {
        let temp_val = UInt8(val ^ zipCryptoEngine.decryptByte() & 0xff)
        zipCryptoEngine.updateKeys(val)
        return temp_val
    }

    public func getHeaderBytes(): Array<Byte> {
        return this.headerBytes
    }
}
